# Ligação ao PostgreSQL. O utilizador tem de poder fazer SET ROLE authenticated
# (é o que faz as políticas RLS aplicarem-se a cada pedido).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymapp

# Código exigido para registar contas de COACH (deixa vazio para desativar o registo de coaches).
COACH_SIGNUP_CODE=

# URL público da app (usado nos links de convite e recuperação de palavra-passe).
APP_URL=http://localhost:3000
